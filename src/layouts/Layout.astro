---
import '../styles/global.css';
import { company, faqs, bestSellers } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  noindex?: boolean;
  schema?: boolean;
}
const {
  title = '3tsmart – Thiết bị nhà thông minh, khóa cửa & công tắc thông minh chính hãng',
  description = '3tsmart tư vấn, cung cấp và lắp đặt trọn gói nhà thông minh: công tắc thông minh, khóa cửa vân tay, camera, rèm tự động, cảm biến. Khảo sát & báo giá miễn phí, bảo hành 24 tháng.',
  path = '/',
  noindex = false,
  schema = false,
} = Astro.props;

const site = Astro.site ?? new URL('https://3tsmart.org');
const canonical = new URL(path, site).toString();
const ogImage = new URL('/og-image.jpg', site).toString();
const gtmId = import.meta.env.PUBLIC_GTM_ID || '';

const jsonLd = schema
  ? [
      {
        '@context': 'https://schema.org',
        '@type': ['Organization', 'ElectronicsStore'],
        '@id': `${site.origin}/#organization`,
        name: company.brand,
        legalName: company.legalName,
        url: site.origin,
        logo: new URL('/icon-512.png', site).toString(),
        image: ogImage,
        telephone: company.hotlineTel,
        email: company.email,
        taxID: company.taxId,
        address: { '@type': 'PostalAddress', streetAddress: company.postalAddress.street, addressLocality: company.postalAddress.locality, addressRegion: company.postalAddress.region, addressCountry: 'VN' },
        openingHours: ['Mo-Sa 08:00-18:00', 'Su 08:30-12:00'],
        priceRange: '$$',
        sameAs: Object.values(company.social),
      },
      {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
      },
      {
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        name: 'Sản phẩm nhà thông minh bán chạy',
        itemListElement: bestSellers.map((p, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          item: { '@type': 'Product', name: p.name, description: p.specs.join(', '), brand: { '@type': 'Brand', name: company.brand } },
        })),
      },
    ]
  : [];
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#07111f" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="vi_VN" />
    <meta property="og:site_name" content="3tsmart" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>document.documentElement.classList.add('js');window.dataLayer=window.dataLayer||[];</script>
    <script is:inline define:vars={{ gtmId }}>window.__GTM_ID__ = gtmId;</script>
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body class="pb-[calc(4rem+env(safe-area-inset-bottom))] lg:pb-0">
    <a href="#main" class="sr-only z-[100] rounded-lg bg-white px-4 py-2 font-semibold text-navy-900 focus:not-sr-only focus:fixed focus:left-4 focus:top-4">Bỏ qua tới nội dung chính</a>
    <slot />
  </body>
</html>
