---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { articles } from '../data/articles';
---
<section class="section bg-surface" aria-labelledby="knowledge-title">
  <div class="container-x">
    <div class="flex flex-wrap items-end justify-between gap-5"><div><p class="eyebrow">Kiến thức & tư vấn</p><h2 id="knowledge-title" class="h2 mt-4">Hiểu trước khi chọn.</h2><p class="lead">Những hướng dẫn giúp bạn đặt đúng câu hỏi và chọn thiết bị phù hợp.</p></div><a href="/kien-thuc" class="btn-outline">Tất cả bài viết <Icon name="ArrowRight" class="size-4" /></a></div>
    <ul class="mt-8 grid gap-6 md:grid-cols-3">
      {articles.map((a) => <li class="card overflow-hidden"><Image src={a.image} alt="Ảnh minh họa cho hướng dẫn chọn thiết bị nhà thông minh" widths={[400, 650]} sizes="(min-width:768px) 33vw, 100vw" class="aspect-[16/10] w-full object-cover" /><div class="p-6"><p class="text-xs font-semibold uppercase tracking-wide text-brand-700">{a.category} · {a.readTime}</p><h3 class="mt-3 text-xl leading-snug"><a href={`/kien-thuc/${a.slug}`} class="hover:text-brand-700">{a.title}</a></h3><p class="mt-3 text-sm text-muted">{a.excerpt}</p><a href={`/kien-thuc/${a.slug}`} class="mt-4 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-brand-700">Đọc hướng dẫn <Icon name="ArrowUpRight" class="size-4" /></a></div></li>)}
    </ul>
    <p class="mt-4 text-xs text-muted">Ảnh bài viết là ảnh minh họa; tính năng cần kiểm tra theo model cụ thể.</p>
  </div>
</section>
