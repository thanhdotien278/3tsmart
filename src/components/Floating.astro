---
import Icon from './Icon.astro';
import BrandIcon from './BrandIcon.astro';
import { company } from '../data/site';
interface Props { home?: boolean }
const { home = true } = Astro.props;
---
<div class="fixed bottom-[calc(5rem+env(safe-area-inset-bottom))] right-4 z-40 flex flex-col items-end gap-3 lg:bottom-6 lg:right-6">
  <button type="button" id="back-to-top" class="grid size-12 translate-y-4 cursor-pointer place-items-center rounded-full border border-line bg-white text-navy-900 opacity-0 shadow-card transition duration-300 hover:-translate-y-0.5 data-[show=true]:translate-y-0 data-[show=true]:opacity-100 pointer-events-none data-[show=true]:pointer-events-auto" aria-label="Lên đầu trang">
    <Icon name="ArrowUp" class="size-5" />
  </button>
  <a href={company.messenger} target="_blank" rel="noopener" data-track="click_messenger" data-track-label="floating" class="grid size-12 place-items-center rounded-full lg:size-13 bg-gradient-to-br from-[#00b2ff] to-[#a033ff] text-white shadow-lg transition hover:scale-105" aria-label="Nhắn tin Messenger">
    <BrandIcon name="messenger" class="size-6 lg:size-7" />
  </a>
  <a href={company.zalo} target="_blank" rel="noopener" data-track="click_zalo" data-track-label="floating" class="hidden size-13 place-items-center rounded-full bg-[#0068ff] text-white shadow-lg transition hover:scale-105 lg:grid" aria-label="Chat Zalo">
    <BrandIcon name="zalo" class="size-9" />
  </a>
  <a href={`tel:${company.hotlineTel}`} data-track="click_call" data-track-label="floating" class="relative hidden size-14 place-items-center rounded-full bg-accent-500 text-navy-950 shadow-lg transition hover:scale-105 lg:grid" aria-label={`Gọi hotline ${company.hotline}`}>
    <span class="absolute inset-0 rounded-full bg-accent-500/60 motion-safe:animate-pulse-ring"></span>
    <Icon name="Phone" class="relative size-6" />
  </a>
</div>

<nav aria-label="Liên hệ nhanh" class="pb-safe fixed inset-x-0 bottom-0 z-40 border-t border-line bg-white/95 backdrop-blur lg:hidden">
  <div class="grid h-16 grid-cols-[1fr_1fr_1.4fr] items-center gap-2 px-3">
    <a href={`tel:${company.hotlineTel}`} data-track="click_call" data-track-label="bottom-bar" class="flex h-12 items-center justify-center gap-1.5 whitespace-nowrap rounded-xl font-semibold text-navy-900 active:bg-surface">
      <Icon name="Phone" class="size-5 text-brand-700" />Gọi ngay
    </a>
    <a href={company.zalo} target="_blank" rel="noopener" data-track="click_zalo" data-track-label="bottom-bar" class="flex h-12 items-center justify-center gap-1.5 whitespace-nowrap rounded-xl font-semibold text-navy-900 active:bg-surface">
      <BrandIcon name="zalo" class="size-6 text-[#0068ff]" />Zalo
    </a>
    <a href={home ? '#lien-he' : '/#lien-he'} data-track="cta_click" data-track-label="bottom-bar" class="btn-primary !min-h-12 !px-3">Nhận báo giá</a>
  </div>
</nav>
