---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { solutions } from '../data/site';
---
<section id="giai-phap" class="section bg-surface" aria-labelledby="solutions-title">
  <div class="container-x">
    <div class="flex flex-wrap items-end justify-between gap-5"><div><p class="eyebrow">Giải pháp theo không gian</p><h2 id="solutions-title" class="h2 mt-4">Mỗi ngôi nhà, một cách tiếp cận.</h2><p class="lead">Không có một bộ thiết bị phù hợp với tất cả. Chọn loại không gian để xem các hạng mục nên trao đổi.</p></div><a href="/giai-phap" class="btn-outline">Xem giải pháp <Icon name="ArrowRight" class="size-4" /></a></div>
    <ul class="mt-8 grid gap-6 md:grid-cols-2">
      {solutions.map((s) => <li class="card group overflow-hidden">
        <a href={`/giai-phap/${s.id}`} class="relative block" tabindex="-1" aria-hidden="true"><Image src={s.image} alt="" widths={[500, 800]} sizes="(min-width:768px) 50vw, 100vw" class="aspect-[16/8] w-full object-cover" /><span class="absolute bottom-3 right-3 rounded bg-white/95 px-2 py-1 text-xs text-navy-900">Ảnh minh họa</span></a>
        <div class="p-6"><h3 class="text-2xl"><a href={`/giai-phap/${s.id}`} class="inline-flex items-center gap-3 group-hover:text-brand-700"><Icon name={s.icon} class="size-6 text-brand-700" />{s.label}</a></h3><p class="mt-3 text-muted">{s.desc}</p><p class="mt-4 text-sm font-medium text-navy-700">{s.devices.join(' · ')}</p><a href={`/giai-phap/${s.id}`} class="mt-4 inline-flex min-h-11 items-center gap-2 font-semibold text-brand-700">Xem phương án gợi ý <Icon name="ArrowUpRight" class="size-4" /></a></div>
      </li>)}
    </ul>
  </div>
</section>
