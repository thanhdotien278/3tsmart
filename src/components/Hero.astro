---
import { Image } from 'astro:assets';
import { hero } from '../data/site';
import Icon from './Icon.astro';
---
<section id="top" aria-labelledby="hero-title" class="page-content bg-[#f2f6f6]">
  <div class="container-x grid items-center gap-10 py-12 sm:py-16 lg:grid-cols-[1fr_1.05fr] lg:gap-12 lg:py-20">
    <div>
      <p class="eyebrow">3tsmart · Thiết bị & giải pháp</p>
      <h1 id="hero-title" class="mt-5 text-[2.6rem] font-bold leading-[1.18] tracking-tight text-navy-950 sm:text-5xl lg:text-[3.5rem]">Một ngôi nhà<br />thông minh.<br /><span class="text-brand-600">Một cuộc sống dễ hơn.</span></h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">Từ một chiếc công tắc đến giải pháp cho cả ngôi nhà. Bắt đầu với điều bạn cần, lựa chọn thiết bị phù hợp và làm rõ phương án trước khi lắp đặt.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/san-pham" class="btn-primary">Khám phá thiết bị <Icon name="ArrowUpRight" class="size-4" /></a>
        <a href="/lien-he" class="btn-secondary">Trao đổi nhu cầu</a>
      </div>
      <div class="mt-9 flex flex-wrap gap-x-5 gap-y-3 border-t border-line pt-5 text-sm font-medium text-navy-700">
        <span class="inline-flex items-center gap-2"><Icon name="MapPin" class="size-4 text-brand-600" /> Kết nối tại Hà Nội</span>
        <span class="inline-flex items-center gap-2"><Icon name="FileText" class="size-4 text-brand-600" /> Tư vấn theo hiện trạng</span>
      </div>
    </div>
    <figure class="relative min-w-0">
      <Image src={hero.image} alt="Không gian phòng khách hiện đại – ảnh minh họa ứng dụng nhà thông minh" widths={[560, 800, 1200]} sizes="(min-width:1024px) 50vw, 100vw" class="aspect-[5/4] w-full rounded-xl object-cover lg:aspect-[4/5]" loading="eager" fetchpriority="high" />
      <div class="absolute inset-x-4 bottom-10 rounded-xl border border-white/50 bg-white/95 p-5 shadow-lg sm:inset-x-7 sm:p-6">
        <div class="flex items-center gap-3"><span class="grid size-11 shrink-0 place-items-center rounded-full bg-brand-50 text-brand-600"><Icon name="House" class="size-5" /></span><div><p class="font-bold text-navy-900">Công nghệ vừa đủ. Tiện nghi đúng nhu cầu.</p><p class="mt-1 text-sm text-muted">Chiếu sáng · An ninh · Rèm · Điều khiển</p></div></div>
      </div>
      <figcaption class="mt-2 text-right text-xs text-muted">Ảnh minh họa không gian, không phải công trình 3tsmart.</figcaption>
    </figure>
  </div>
  <div class="border-y border-line bg-white">
    <div class="container-x grid divide-y divide-line sm:grid-cols-3 sm:divide-x sm:divide-y-0">
      {[
        ['01', 'Tìm đúng thiết bị', 'Xem nhóm thiết bị và các lưu ý trước khi mua.', '/san-pham'],
        ['02', 'Chọn theo không gian', 'Căn hộ, nhà phố, biệt thự và văn phòng.', '/giai-phap'],
        ['03', 'Trao đổi phương án', 'Gửi nhu cầu để làm rõ cấu hình và chi phí.', '/lien-he'],
      ].map(([n, title, text, href]) => <a href={href} class="group flex gap-4 py-6 sm:px-6 first:sm:pl-0 last:sm:pr-0"><span class="pt-1 text-xs font-bold text-brand-600">{n}</span><div><h2 class="text-base font-semibold group-hover:text-brand-600">{title} <span aria-hidden="true">↗</span></h2><p class="mt-1 text-sm text-muted">{text}</p></div></a>)}
    </div>
  </div>
</section>
