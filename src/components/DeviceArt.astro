---
/** Minh hoạ thiết bị dạng vector (thay bằng ảnh sản phẩm thật khi có). */
interface Props { kind: string; class?: string; label?: string }
const { kind, class: className = 'w-full h-auto', label } = Astro.props;
const uid = `${kind}-${Math.random().toString(36).slice(2, 8)}`;
const g = (n: string) => `${uid}-${n}`;
---
<svg viewBox="0 0 200 150" class={className} role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  <defs>
    <linearGradient id={g('glass')} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#1a3350" /><stop offset="1" stop-color="#07111f" />
    </linearGradient>
    <linearGradient id={g('white')} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff" /><stop offset="1" stop-color="#dfe8f0" />
    </linearGradient>
    <radialGradient id={g('glow')} cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="#0cc6fa" stop-opacity="0.55" /><stop offset="1" stop-color="#0cc6fa" stop-opacity="0" />
    </radialGradient>
    <filter id={g('shadow')} x="-30%" y="-30%" width="160%" height="170%">
      <feDropShadow dx="0" dy="8" stdDeviation="7" flood-color="#0b1b2e" flood-opacity="0.22" />
    </filter>
  </defs>
  <ellipse cx="100" cy="134" rx="56" ry="6" fill="#0b1b2e" opacity="0.08" />

  {kind === 'switch' && (
    <g filter={`url(#${g('shadow')})`}>
      <rect x="52" y="22" width="96" height="96" rx="16" fill={`url(#${g('glass')})`} stroke="#ffffff" stroke-opacity="0.12" />
      <rect x="58" y="28" width="84" height="84" rx="12" fill="none" stroke="#0cc6fa" stroke-opacity="0.18" />
      <line x1="86" y1="36" x2="86" y2="104" stroke="#ffffff" stroke-opacity="0.08" />
      <line x1="114" y1="36" x2="114" y2="104" stroke="#ffffff" stroke-opacity="0.08" />
      <circle cx="72" cy="70" r="16" fill={`url(#${g('glow')})`} />
      <circle cx="72" cy="70" r="5" fill="#0cc6fa" />
      <circle cx="100" cy="70" r="5" fill="none" stroke="#9fb4c8" stroke-width="2" />
      <circle cx="128" cy="70" r="16" fill={`url(#${g('glow')})`} />
      <circle cx="128" cy="70" r="5" fill="#0cc6fa" />
    </g>
  )}

  {kind === 'socket' && (
    <g filter={`url(#${g('shadow')})`}>
      <rect x="56" y="24" width="88" height="92" rx="18" fill={`url(#${g('white')})`} stroke="#cbd8e4" />
      <circle cx="100" cy="68" r="30" fill="#f4f8fb" stroke="#d5e1ec" />
      <rect x="86" y="58" width="6" height="18" rx="3" fill="#1e293b" />
      <rect x="108" y="58" width="6" height="18" rx="3" fill="#1e293b" />
      <circle cx="100" cy="104" r="3.5" fill="#0cc6fa" />
      <circle cx="100" cy="104" r="9" fill={`url(#${g('glow')})`} />
    </g>
  )}

  {kind === 'lock' && (
    <g filter={`url(#${g('shadow')})`}>
      <rect x="74" y="12" width="44" height="120" rx="14" fill={`url(#${g('glass')})`} stroke="#ffffff" stroke-opacity="0.12" />
      <rect x="82" y="22" width="28" height="18" rx="6" fill="#0b1b2e" stroke="#0cc6fa" stroke-opacity="0.5" />
      <circle cx="96" cy="31" r="4" fill="#0cc6fa" />
      {[0, 1, 2].map((r) => [0, 1, 2].map((c) => <circle cx={86 + c * 10} cy={52 + r * 10} r="2.6" fill="#0cc6fa" opacity={0.55 + 0.15 * ((r + c) % 3)} />))}
      <circle cx="96" cy="100" r="9" fill="none" stroke="#0cc6fa" stroke-width="1.6" />
      <path d="M91 100a5 5 0 0 1 10 0M93.5 103a2.5 2.5 0 0 1 5 0" fill="none" stroke="#0cc6fa" stroke-width="1.4" stroke-linecap="round" />
      <rect x="112" y="84" width="46" height="11" rx="5.5" fill="#c7d3df" stroke="#9fb0c2" />
      <rect x="112" y="84" width="10" height="11" rx="3" fill="#9fb0c2" />
    </g>
  )}

  {kind === 'camera' && (
    <g filter={`url(#${g('shadow')})`}>
      <path d="M80 122h40l-6-14H86z" fill="#dfe8f0" stroke="#cbd8e4" />
      <rect x="92" y="96" width="16" height="14" rx="4" fill="#e9eff5" />
      <circle cx="100" cy="64" r="40" fill={`url(#${g('white')})`} stroke="#cbd8e4" />
      <rect x="66" y="44" width="68" height="40" rx="20" fill={`url(#${g('glass')})`} />
      <circle cx="100" cy="64" r="13" fill="#07111f" stroke="#0cc6fa" stroke-width="2" />
      <circle cx="100" cy="64" r="6" fill="#12263d" />
      <circle cx="97" cy="61" r="2" fill="#ffffff" opacity="0.8" />
      <circle cx="122" cy="56" r="2.4" fill="#0cc6fa" />
    </g>
  )}

  {kind === 'doorbell' && (
    <g filter={`url(#${g('shadow')})`}>
      <rect x="80" y="10" width="40" height="122" rx="20" fill={`url(#${g('glass')})`} stroke="#ffffff" stroke-opacity="0.12" />
      <circle cx="100" cy="36" r="11" fill="#07111f" stroke="#0cc6fa" stroke-opacity="0.6" stroke-width="1.6" />
      <circle cx="100" cy="36" r="4.5" fill="#12263d" />
      <circle cx="98.5" cy="34.5" r="1.4" fill="#ffffff" opacity="0.8" />
      <circle cx="100" cy="102" r="20" fill={`url(#${g('glow')})`} />
      <circle cx="100" cy="102" r="11" fill="none" stroke="#0cc6fa" stroke-width="3" />
      <circle cx="100" cy="102" r="6" fill="#1a3350" />
    </g>
  )}

  {kind === 'curtain' && (
    <g filter={`url(#${g('shadow')})`}>
      <rect x="22" y="18" width="156" height="10" rx="5" fill="#c7d3df" />
      <rect x="140" y="12" width="40" height="22" rx="11" fill={`url(#${g('white')})`} stroke="#cbd8e4" />
      <circle cx="170" cy="23" r="3" fill="#0cc6fa" />
      {[0, 1, 2, 3, 4, 5].map((i) => (
        <path d={`M${30 + i * 13} 28 q6 50 0 100 h13 q-6 -50 0 -100z`} fill={i % 2 ? '#e7eef5' : '#f8fbfd'} stroke="#d5e1ec" />
      ))}
      {[0, 1, 2].map((i) => (
        <path d={`M${135 + i * 13} 34 q6 46 0 94 h13 q-6 -46 0 -94z`} fill={i % 2 ? '#e7eef5' : '#f8fbfd'} stroke="#d5e1ec" />
      ))}
      <path d="M118 62l8 8-8 8M112 62l8 8-8 8" fill="none" stroke="#0cc6fa" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
    </g>
  )}

  {kind === 'ir' && (
    <g filter={`url(#${g('shadow')})`}>
      <path d="M60 70v28c0 9 18 16 40 16s40-7 40-16V70" fill={`url(#${g('glass')})`} />
      <ellipse cx="100" cy="70" rx="40" ry="16" fill="#1a3350" stroke="#ffffff" stroke-opacity="0.15" />
      <ellipse cx="100" cy="98" rx="40" ry="16" fill="none" stroke="#0cc6fa" stroke-opacity="0.35" />
      <circle cx="100" cy="70" r="4" fill="#0cc6fa" />
      <path d="M78 46a30 30 0 0 1 44 0M86 54a18 18 0 0 1 28 0" fill="none" stroke="#0cc6fa" stroke-width="3" stroke-linecap="round" />
    </g>
  )}

  {kind === 'hub' && (
    <g filter={`url(#${g('shadow')})`}>
      <rect x="54" y="30" width="92" height="92" rx="24" fill={`url(#${g('white')})`} stroke="#cbd8e4" />
      <circle cx="100" cy="76" r="30" fill={`url(#${g('glow')})`} />
      <circle cx="100" cy="76" r="22" fill="none" stroke="#0cc6fa" stroke-width="3" />
      <circle cx="100" cy="76" r="5" fill="#0cc6fa" />
      <path d="M78 22a32 32 0 0 1 44 0M86 14a46 46 0 0 1 28 0" fill="none" stroke="#0cc6fa" stroke-width="3" stroke-linecap="round" opacity="0.8" />
    </g>
  )}

  {kind === 'sensor' && (
    <g filter={`url(#${g('shadow')})`}>
      <rect x="64" y="44" width="72" height="72" rx="18" fill={`url(#${g('white')})`} stroke="#cbd8e4" />
      <circle cx="100" cy="80" r="16" fill="#f0f5f9" stroke="#d5e1ec" />
      <circle cx="100" cy="80" r="6" fill="#1a3350" />
      <circle cx="122" cy="58" r="3" fill="#0cc6fa" />
      <path d="M146 60a26 26 0 0 1 0 40M156 50a40 40 0 0 1 0 60M54 60a26 26 0 0 0 0 40M44 50a40 40 0 0 0 0 60" fill="none" stroke="#0cc6fa" stroke-width="3" stroke-linecap="round" opacity="0.7" />
    </g>
  )}

  {kind === 'light' && (
    <g filter={`url(#${g('shadow')})`}>
      <circle cx="100" cy="62" r="46" fill={`url(#${g('glow')})`} />
      <path d="M100 22a36 36 0 0 0-20 66c3 2 5 6 5 10v6h30v-6c0-4 2-8 5-10a36 36 0 0 0-20-66z" fill={`url(#${g('white')})`} stroke="#cbd8e4" />
      <rect x="85" y="106" width="30" height="8" rx="3" fill="#9fb0c2" />
      <rect x="88" y="116" width="24" height="8" rx="3" fill="#7d90a5" />
      <path d="M92 76l8-14 8 14" fill="none" stroke="#0cc6fa" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
    </g>
  )}
</svg>
