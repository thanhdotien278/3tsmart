---
interface Props { eyebrow: string; title: string; lead: string; parent?: { href: string; label: string } }
const { eyebrow, title, lead, parent } = Astro.props;
---
<div class="border-b border-line bg-[#f2f6f6] py-10 sm:py-14">
  <div class="container-x">
    <nav aria-label="Đường dẫn" class="flex flex-wrap items-center gap-2 text-sm text-muted">
      <a href="/" class="hover:text-brand-700">Trang chủ</a><span aria-hidden="true">/</span>
      {parent && <><a href={parent.href} class="hover:text-brand-700">{parent.label}</a><span aria-hidden="true">/</span></>}
      <span aria-current="page">{eyebrow}</span>
    </nav>
    <p class="mt-8 text-sm font-semibold uppercase tracking-wider text-brand-700">{eyebrow}</p>
    <h1 class="mt-3 max-w-4xl text-3xl leading-tight sm:text-5xl">{title}</h1>
    <p class="lead">{lead}</p>
  </div>
</div>
