---
import DeviceArt from './DeviceArt.astro';
import Icon from './Icon.astro';
import { categories, productTabs } from '../data/site';
interface Props { catalog?: boolean }
const { catalog = false } = Astro.props;
const items = catalog ? categories : categories.slice(0, 4);
---
<section id="san-pham" class="section" aria-labelledby="products-title">
  <div class="container-x">
    <div class="flex flex-wrap items-end justify-between gap-5">
      <div><p class="eyebrow">Danh mục thiết bị</p><h2 id="products-title" class="h2 mt-4">{catalog ? 'Tìm thiết bị theo nhu cầu' : 'Bắt đầu từ điều bạn cần.'}</h2><p class="lead">Tìm hiểu công dụng, lưu ý lắp đặt và gửi yêu cầu cấu hình. Model, giá và tình trạng hàng được xác nhận khi tư vấn.</p></div>
      {!catalog && <a href="/san-pham" class="btn-outline">Xem tất cả <Icon name="ArrowRight" class="size-4" /></a>}
    </div>
    {catalog && <div class="mt-8 rounded-xl bg-surface p-5 sm:p-6">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div class="w-full sm:max-w-md"><label for="catalog-search" class="field-label">Bạn đang tìm thiết bị gì?</label><input type="search" id="catalog-search" class="field" placeholder="Ví dụ: khóa cửa, rèm, đèn…" autocomplete="off" /></div>
        <p id="catalog-count" class="text-sm text-muted" role="status" aria-live="polite">{items.length} nhóm thiết bị</p>
      </div>
      <div class="mt-5 flex flex-wrap gap-2" role="group" aria-label="Lọc theo nhóm thiết bị">
        {productTabs.map((t, i) => <button type="button" data-filter={t.id} aria-pressed={i === 0 ? 'true' : 'false'} class="min-h-11 cursor-pointer rounded-lg border border-slate-300 bg-white px-4 text-sm font-semibold transition hover:border-brand-700 aria-[pressed=true]:border-navy-900 aria-[pressed=true]:bg-navy-900 aria-[pressed=true]:text-white">{t.label}</button>)}
      </div>
      <noscript><p class="mt-3 text-sm">Bật JavaScript để tìm kiếm và lọc. Bạn vẫn có thể xem mọi nhóm thiết bị bên dưới.</p></noscript>
    </div>}
    <ul id="product-grid" class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {items.map((p) => <li data-group={p.group} data-search={p.name + ' ' + p.desc + ' ' + p.checks.join(' ')} class="card group flex flex-col overflow-hidden transition hover:border-brand-200 hover:shadow-card">
        <a href={`/san-pham/${p.id}`} class="block bg-surface p-6" tabindex="-1" aria-hidden="true"><DeviceArt kind={p.art} class="mx-auto h-36 w-full transition duration-300 group-hover:scale-105" /></a>
        <div class="flex flex-1 flex-col p-5"><p class="text-xs text-muted">Minh họa nhóm thiết bị</p><h3 class="mt-2 text-lg"><a href={`/san-pham/${p.id}`} class="hover:text-brand-700">{p.name}</a></h3><p class="mt-2 flex-1 text-sm text-muted">{p.desc}</p><div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-4"><a href={`/san-pham/${p.id}`} class="inline-flex min-h-11 items-center gap-1 text-sm font-semibold text-brand-700">Tìm hiểu <Icon name="ArrowUpRight" class="size-4" /></a><a href={`/lien-he?thiet-bi=${encodeURIComponent(p.name)}#lead-form`} class="btn-primary !px-3 text-sm">Hỏi giá</a></div></div>
      </li>)}
    </ul>
    <div id="catalog-empty" class="mt-8 rounded-xl border border-dashed border-slate-300 p-8 text-center" hidden><h3 class="text-xl">Chưa tìm thấy nhóm thiết bị phù hợp</h3><p class="mt-2 text-muted">Thử từ khóa khác hoặc bỏ bộ lọc đang chọn.</p><button type="button" id="catalog-reset" class="btn-outline mt-4">Xóa tìm kiếm & bộ lọc</button><a href="/lien-he" class="btn-ghost mt-4">Nhờ 3tsmart tư vấn</a></div>
  </div>
</section>
