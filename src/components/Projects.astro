---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { publishedProjects } from '../data/site';
---
<section id="du-an" class="section" aria-labelledby="projects-title">
  <div class="container-x">
    <p class="eyebrow">Hồ sơ công trình</p>
    <div class="mt-4 flex flex-wrap items-end justify-between gap-5"><div><h2 id="projects-title" class="h2">Công trình phải được kể bằng thực tế.</h2><p class="lead">Hiện trạng, hạng mục lắp đặt, hình ảnh và thông tin bàn giao — thay cho những con số không có căn cứ.</p></div><a href="/cong-trinh" class="btn-outline">Xem hồ sơ <Icon name="ArrowRight" class="size-4" /></a></div>
    {publishedProjects.length ? <ul class="mt-8 grid gap-6 md:grid-cols-3">{publishedProjects.map((p) => <li class="card overflow-hidden"><Image src={p.image} alt={p.name} width={640} class="aspect-[4/3] w-full object-cover" /><div class="p-5"><p class="text-sm text-brand-700">{p.type} · {p.location}</p><h3 class="mt-2 text-xl"><a href={`/cong-trinh/${p.slug}`} class="hover:text-brand-700">{p.name}</a></h3><p class="mt-2 text-sm text-muted">{p.summary}</p><a href={`/cong-trinh/${p.slug}`} class="btn-ghost mt-3 !px-0">Xem hồ sơ công trình</a></div></li>)}</ul> :
      <div class="mt-8 grid gap-8 rounded-xl bg-navy-900 p-7 sm:p-10 md:grid-cols-[1.1fr_1fr]">
        <div><span class="inline-flex items-center gap-2 text-sm font-semibold text-brand-300"><Icon name="FolderOpen" class="size-5" /> Đang cập nhật hồ sơ</span><h3 class="mt-4 text-2xl text-white">Ảnh thật. Thông tin rõ. Được phép công bố.</h3><p class="mt-4 text-slate-300">Chúng tôi chưa công bố công trình khi thiếu ảnh thực tế và thông tin xác nhận. Những ảnh không gian trên website chỉ dùng để minh họa giải pháp.</p><a href="/lien-he" class="btn-primary mt-6">Trao đổi về công trình của bạn</a></div>
        <ol class="grid gap-4 text-slate-300">{['Thông tin loại hình và khu vực công trình', 'Nhu cầu ban đầu & phương án lựa chọn', 'Hạng mục và model thiết bị đã lắp', 'Ảnh hiện trạng, lắp đặt & bàn giao'].map((t, i) => <li class="flex items-center gap-4 border-b border-white/10 pb-4"><span class="text-sm text-brand-300">0{i + 1}</span><span>{t}</span></li>)}</ol>
      </div>}
  </div>
</section>
