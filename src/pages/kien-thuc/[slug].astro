---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { Image } from 'astro:assets';
import SitePage from '../../layouts/SitePage.astro';
import PageIntro from '../../components/PageIntro.astro';
import { articles } from '../../data/articles';
export const getStaticPaths = (() => articles.map((item) => ({ params: { slug: item.slug }, props: { item } }))) satisfies GetStaticPaths;
const { item } = Astro.props as InferGetStaticPropsType<typeof getStaticPaths>;
---
<SitePage title={`${item.title} | 3tsmart`} description={item.excerpt}>
  <PageIntro eyebrow={item.category} title={item.title} lead={item.excerpt} parent={{ href: '/kien-thuc', label: 'Kiến thức' }} />
  <article class="container-x grid gap-10 py-12 lg:grid-cols-[1fr_280px]">
    <div class="min-w-0"><p class="mb-6 text-sm text-muted">Hướng dẫn từ 3tsmart · {item.readTime} đọc</p><figure><Image src={item.image} widths={[650, 1000]} sizes="(min-width:1024px) 70vw, 100vw" alt="Không gian và thiết bị – ảnh minh họa bài viết" class="aspect-[16/9] w-full rounded-xl object-cover" /><figcaption class="mt-2 text-xs text-muted">Ảnh minh họa, không phải hình công trình 3tsmart.</figcaption></figure><div class="editorial-copy">{item.sections.map((s, i) => <section id={`muc-${i}`}><h2>{s.title}</h2><p>{s.text}</p><ul>{s.items.map((t) => <li>{t}</li>)}</ul></section>)}</div><p class="mt-8 rounded-xl bg-brand-50 p-5 text-sm text-muted">Thông tin mang tính hướng dẫn. Tính năng, cách lắp và bảo hành cần kiểm tra theo tài liệu của model cụ thể; công việc điện nên do người có chuyên môn thực hiện.</p></div>
    <aside><nav aria-label="Mục lục bài viết" class="card p-6"><h2 class="text-lg">Trong bài viết</h2><ul class="mt-4 space-y-3">{item.sections.map((s, i) => <li><a href={`#muc-${i}`} class="inline-block py-1 text-sm text-muted hover:text-brand-700">{s.title}</a></li>)}</ul></nav><div class="mt-5 rounded-xl bg-navy-900 p-6"><h2 class="text-xl text-white">Bạn đang chọn thiết bị?</h2><p class="mt-3 text-sm text-slate-300">Gửi hiện trạng và nhu cầu để cùng làm rõ phương án.</p><a href="/lien-he" class="btn-primary mt-5 w-full text-sm">Trao đổi với 3tsmart</a></div><h2 class="mt-8 text-lg">Đọc tiếp</h2><ul class="mt-4 space-y-4">{articles.filter((a) => a.slug !== item.slug).map((a) => <li><a href={`/kien-thuc/${a.slug}`} class="text-sm font-medium text-brand-700 hover:underline">{a.title}</a></li>)}</ul></aside>
  </article>
</SitePage>
