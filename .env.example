# URL chính thức của website (dùng cho canonical, sitemap, Open Graph)
SITE_URL=https://3tsmart.org
# URL Web App Google Apps Script nhận lead (xem integrations/google-apps-script.gs)
# Để trống: form soạn email; khách phải bấm gửi trong ứng dụng email
PUBLIC_LEAD_ENDPOINT=
# Mã Google Tag Manager, ví dụ GTM-XXXXXXX (để trống nếu chưa dùng)
PUBLIC_GTM_ID=
